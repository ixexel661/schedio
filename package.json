{
	"name": "schedio",
	"version": "0.1.0",
	"description": "A zero-dependency Node.js scheduling library with a fluent, human-readable API no cron syntax required.",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"import": {
				"default": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	},
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"example:seconds": "tsx examples/every-second.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/node": "^25.9.2",
		"@vitest/coverage-v8": "^4.1.8",
		"tsdown": "^0.22.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.8",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"keywords": [
		"cron",
		"scheduler",
		"fluent",
		"timer",
		"job",
		"jobs"
	]
}
